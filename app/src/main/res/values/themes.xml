        <item name="colorOutline">@color/light_slate_outline</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowBackground">@color/light_slate_background</item>
    </style>

    <!-- 合成器宿主窗口主题：DeviceDefault 深色（非 AppCompat，配合
         TawcCompositorActivity : Activity）。深色避免浅色 Material3 主题的
         窗口格式与合成器 EGL 配置（RGBA8）不匹配导致黑屏。 -->
    <style name="Theme.CodeTool.Compositor" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:colorBackground">#FF0E1514</item>
        <item name="android:windowBackground">#FF0E1514</item>
    </style>

    <!-- 文件页统一 chip 样式：所有入口（含收藏）都有 1dp 边框，
         选中时用主色容器背景 + 主色边框 + 高对比文字。 -->
    <style name="Widget.CodeTool.FileChip" parent="Widget.Material3.Chip.Filter">
        <!-- 描边宽度随 checked 变化，由 FilesFragment.setChipChecked 设置初始值 -->
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/file_chip_stroke</item>
        <item name="chipBackgroundColor">@color/file_chip_bg</item>
        <item name="android:textColor">@color/file_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
</resources>
