<?xml version="1.0" encoding="utf-8"?>
<!-- 编辑器底部搜索/替换条（MT 管理器风格）：默认 gone，点标题栏搜索按钮 toggle 显示/关闭。
     结构（竖向根，纯平通栏 + 顶部 1dp 细分隔线，贴底）：
       行1 查找：查找输入框（weight 1）+ 匹配计数
       行2 替换：替换输入框（weight 1）
       行3 按钮：上个 / 下个 / 替换 / 全部（文字按钮）+ 关闭(× 图标)
     文字色跟随主题（浅色深字、深色浅字，绝不纯黑底白字）。查找/替换框样式与页面输入框统一。
     关闭：× 图标 + 标题栏搜索按钮都能收起；220ms 下滑动画后彻底 GONE（不留黑杠）。
     键盘弹出时控制器用 IME inset 把本条顶到键盘上方（不依赖 windowSoftInputMode）。
     被 ScriptEdit / ConfigEditor / SkillEditor 三个编辑页 include 复用。
     注意：include 时不能加 android:id（会覆盖根节点 searchBar id → findViewById null 崩溃）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_editor_search_bar"
    android:visibility="gone">

    <!-- 顶部细分隔线：与上方编辑区分隔（色跟随主题 outlineVariant） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- 行1 查找：查找框 + 匹配计数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="查找"
            android:background="@null"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:singleLine="true"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <!-- 计数：常显匹配数，浅灰小字，不挤压输入框 -->
        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="end"
            android:paddingStart="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="" />
    </LinearLayout>

    <!-- 行2 替换：替换为输入框（默认隐藏，首次点「替换」按钮才展开；替换/全部替换时读取此内容） -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/replaceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="替换为"
        android:background="@null"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:singleLine="true"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <!-- 行3 按钮：上个 / 下个 / 替换 / 全部（文字按钮，colorPrimary）+ 关闭(× 图标) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/searchPrev"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="上个"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/searchNext"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="下个"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/searchReplace"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="替换"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/searchReplaceAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="全部"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 关闭：彻底收起搜索/替换条 -->
        <ImageButton
            android:id="@+id/searchClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="关闭搜索"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 底部安全区留白：避免被导航条遮挡（键盘 inset 由控制器动态补） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp" />
</LinearLayout>
