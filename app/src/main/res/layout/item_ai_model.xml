<?xml version="1.0" encoding="utf-8"?>
<!-- 模型清单条目：卡片 + 标签化信息行。禁止回退到 Kotlin 里 addView 拼一团文本。 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 + 状态徽标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/modelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/modelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 目标 / 协议 摘要 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/modelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorSurfaceVariant" />

        <!-- 一行一个字段：label 固定宽 + value 权重 1，长地址省略不撑乱布局 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="服务商" android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/modelProvider" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:singleLine="true" android:ellipsize="end"
                    android:textSize="13sp" android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="模型 ID" android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/modelId" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:singleLine="true" android:ellipsize="end"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="4dp">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="API 地址" android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/modelBaseUrl" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:singleLine="true" android:ellipsize="end"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:text="API Key" android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/modelKey" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:singleLine="true" android:ellipsize="end"
                    android:textSize="13sp" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <!-- 主操作 + 编辑同一行，12dp 间距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelCurrent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="设为当前" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelEdit"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:minHeight="40dp"
                android:maxLines="1"
                android:singleLine="true"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="编辑" />
        </LinearLayout>

        <!-- 破坏性操作独立一行：描边 + 8dp 上间距，不易误点 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelDelete"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:text="删除" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
