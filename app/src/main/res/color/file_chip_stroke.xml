<?xml version="1.0" encoding="utf-8"?>
<!-- 选中态与终端标签一致：主色 1.5dp 描边；未选中 outlineVariant 1dp。
     描边宽度在 FilesFragment 里跟随 checked 状态设置（attr 不支持 state list）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorPrimary" />
    <item android:color="?attr/colorOutlineVariant" />
</selector>
